<?php
// Copy to custom_read_sensor_data.php and keep only the sensors this site has.
// Readers in functions_hw_sensors.php use kernel drivers: no Python, no sudo.
require_once 'functions_hw_sensors.php';

function read_sensor_data_custom ()  {

	// DS18B20 thermometers (needs dtoverlay=w1-gpio)
	foreach (read_ds18b20_sensors() as $sensor_id => $celsius) {
		add_sensor_reading($sensor_id, $celsius);
	}

	// DHT22 / DHT11 (needs dtoverlay=dht11,gpiopin=N)
	$dht = read_dht_sensor();
	if ($dht !== null) {
		add_sensor_reading('dht_temperature', $dht['temperature']);
		add_sensor_reading('dht_humidity', $dht['humidity']);
	}

	// Demo values; remove on a real site.
	add_sensor_reading("dummy_data1", rand(20,40));
	add_sensor_reading("dummy_data2", rand(10,15));
}
