<?php
// Site settings. Copy to custom_app_config.php.
// Devices installed with provision/install.sh keep the API key, storage paths and
// monitor credentials in /etc/remote-pi/ (outside the web root), which override this file.

// token used for API calls (legacy installs only; must be unique per device)
$config_API_KEY = "new-key";

// sensor data save parameters
$allDataSaveHours = 3;
$allDataSaveIntervalSeconds = 1 * 60; // 1 minute

$midTermSaveDays = 90;
$midTermSaveIntervalSeconds = 10 * 60; //10 minutes

$longTermSaveDays = 365;  // all records older than this will be deleted.
$longTermSaveIntervalSeconds = 60 * 60; // 1 hour

// SD card writes: readings are kept in RAM and moved to storage this often
// (a power cut loses at most this much data), with a new backup file once a day.
$sensor_log_flush_interval_seconds = 60 * 60;
$sensor_log_backup_interval_seconds = 24 * 60 * 60;
// Settings/pin changes are saved to storage once nothing has changed for this long (0 = at once).
$static_db_save_delay_seconds = 120;

// monitoring parameters v2

  $monitor_url_v2 = "https://rocket-app-j2lxa6zaaq-ey.a.run.app/checkin" ;
  $monitor_enabled = true;
  $monitor_API_key = "new-key";
  $monitor2_node_ID = "devtest1";
  // Set false for the new server; true preserves compatibility with old production.
  $monitor_legacy_body_key = true;
  $monitor_interval_seconds = 60;
  $monitor_sample_max_age_seconds = 30;
  // Must be writable on a read-only root: use a RAM directory created at boot.
  $monitor_state_dir = '/run/remote-pi-monitor';
  // Prefer a protected file outside the web root over a key in this file.
  // $monitor_api_key_file = '/etc/remote-pi/monitor-api-key';

  $GPIO_reverse = false; // some relay boards have reversed logic (no signal = ON)
