# Remote PI site settings for provision/install.sh. Copy per device, e.g. laistisana.env.
# This file is sourced by bash as root: plain VAR="value" lines only.
# Keep real site files (and key files) out of the public repository.

# --- Device -------------------------------------------------------------------
DEVICE_HOSTNAME="pi-laistisana"
TIMEZONE="Europe/Riga"
# Account created in Raspberry Pi Imager. Must already have your SSH public key,
# because password login is switched off.
ADMIN_USER="pi"

# --- Network ------------------------------------------------------------------
# Who may reach SSH and the web app. Everything else is dropped.
LAN_CIDRS="192.168.88.0/24"
# Extra listen ports for the web app, e.g. "1111" if the router forwards it.
EXTRA_HTTP_PORTS=""
# Interfaces trusted like the LAN, e.g. "tailscale0" or "wg0".
ALLOW_INTERFACES=""
# Time sources; the MikroTik router can serve NTP on the LAN.
NTP_SERVERS="192.168.88.1 0.debian.pool.ntp.org 1.debian.pool.ntp.org"

# --- Data partition -----------------------------------------------------------
# auto = the partition after root on the boot card (created in free space when
# missing). Or a device such as /dev/sda1 for a USB stick (must be ext4 or empty).
DATA_DEVICE="auto"
DATA_CREATE_PARTITION="yes"
# Grow the root partition to this size before creating the data partition (0 = leave).
ROOT_SIZE_GB="4"

# --- Application --------------------------------------------------------------
# Folder with this site's custom_*.php files (relative to this file or absolute),
# e.g. ../custom_configuration/r-laistisana
SITE_FILES_DIR=""
# Prebuilt Ionic app: a local folder, or a git repository + ref + sub-folder.
UI_SOURCE="https://github.com/krisjanis-gross/remote-pi-ionic-v7.git"
UI_REF="master"
UI_SUBDIR="www-for-server"
# Leave empty to generate a unique key on the first install (printed once, kept on re-runs).
API_KEY=""
# Browser origins allowed to call the API besides the Pi's own page.
CORS_ALLOWED_ORIGINS="capacitor://localhost ionic://localhost http://localhost https://localhost"

# --- Hardware -----------------------------------------------------------------
# config.txt overlays, space separated. Examples:
#   w1-gpio                DS18B20 thermometers on GPIO4
#   dht11,gpiopin=24       DHT11/DHT22 on GPIO24
#   i2c-rtc,ds3231         DS3231 battery clock (also set RTC_MODULE=yes)
DTOVERLAYS="w1-gpio"
RTC_MODULE="no"
# yes = install python3-rpi-lgpio for site scripts that still use RPi.GPIO
PYTHON_GPIO="no"
DISABLE_BLUETOOTH="yes"

# --- Monitor ------------------------------------------------------------------
MONITOR_ENABLED="no"
MONITOR_URL="https://remote-pi-monitor-staging-1050773679295.europe-west3.run.app/checkin"
MONITOR_NODE_ID="pi-laistisana"
# Local file holding the monitor key; copied to /etc/remote-pi/monitor-api-key.
MONITOR_KEY_FILE=""
MONITOR_LEGACY_BODY_KEY="false"

# --- Read-only root -----------------------------------------------------------
ENABLE_OVERLAY="yes"
