# Remote PI core (Rust + Lua): the rules, the GPIO outputs, the sensors and the
# app's API. Not installed by provision/install.sh yet; see core/README.md.
#
# --watch-only runs next to the PHP backend: it switches nothing and writes
# nothing, and logs where it would have acted differently (journalctl -u remote-pi-core).
# Its API (set in /etc/remote-pi/core.toml) then only answers reads, and must
# listen on another port than nginx.
# Without --watch-only the core switches the pins: stop remote-pi-worker first,
# or both will drive them.
[Unit]
Description=Remote PI core: rules, GPIO, sensors and the app's API
After=local-fs.target network.target

[Service]
ExecStart=@CORE_BIN@ run @SITE_RULES@ --config /etc/remote-pi/core.toml --watch-only
User=www-data
Group=www-data
# pinctrl writes the GPIO registers through /dev/gpiomem.
SupplementaryGroups=gpio
# The API on port 80, without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
# On stop the core switches every output off (live mode).
TimeoutStopSec=10
MemoryMax=64M

NoNewPrivileges=yes
ProtectSystem=strict
# The settings database and the sensor log in RAM, and their copies on /data.
ReadWritePaths=/run/remote-pi /data/sqlite
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/gpiomem0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
