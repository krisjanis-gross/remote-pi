# Remote PI site settings: pi-laistisana (Raspberry Pi 2, 192.168.88.249).
# Paths are relative to this file. In git: this file and php/; secrets/ and ui/ stay local.
# Install or update: provision/deploy.sh sites/laistisana

# --- Device -------------------------------------------------------------------
DEVICE_HOSTNAME="pi-laistisana"
TIMEZONE="Europe/Riga"
ADMIN_USER="pi"
# How provision/deploy.sh reaches the device.
SSH_TARGET="pi@192.168.88.249"

# --- Network ------------------------------------------------------------------
LAN_CIDRS="192.168.88.0/24"
# The old install also served the app on 1111 (router port forward).
EXTRA_HTTP_PORTS="1111"
ALLOW_INTERFACES=""
NTP_SERVERS="0.debian.pool.ntp.org 1.debian.pool.ntp.org 2.debian.pool.ntp.org"   # the router (192.168.88.1) does not answer NTP

# --- Data partition -----------------------------------------------------------
# 7.4 GB card: 4 GB root, the rest (~3.2 GB) for /data.
DATA_DEVICE="auto"
DATA_CREATE_PARTITION="yes"
ROOT_SIZE_GB="4"

# --- Application --------------------------------------------------------------
# What runs the device:
#   php        the PHP backend (nginx, PHP-FPM, the Python worker)
#   php+watch  the PHP backend, with the core (core/, Rust + Lua) next to it in watch-only
#              mode: it switches nothing, and logs where it would have acted differently
#   core       the core alone: rules, GPIO, sensors, sensor log, monitor and the app's API;
#              PHP, nginx and the worker are removed
# php+watch and core need the site's rules/ (rules.lua, device.toml) and Docker on the
# computer running provision/deploy.sh, which builds the core.
BACKEND="core"
SITE_FILES_DIR="php"
# built from client/ by provision/deploy.sh
UI_SOURCE="client"
# Empty: a new key is generated (the old device used the default key).
API_KEY=""
CORS_ALLOWED_ORIGINS="capacitor://localhost ionic://localhost http://localhost https://localhost"

# --- Hardware -----------------------------------------------------------------
DTOVERLAYS="w1-gpio"
RTC_MODULE="no"
PYTHON_GPIO="no"
DISABLE_BLUETOOTH="yes"

# --- Monitor ------------------------------------------------------------------
MONITOR_ENABLED="yes"
MONITOR_URL="https://rocket-app-j2lxa6zaaq-ey.a.run.app/checkin"
MONITOR_NODE_ID="devtest1"
MONITOR_KEY_FILE="secrets/monitor-api-key"
MONITOR_LEGACY_BODY_KEY="true"   # the monitor server needs api_key in the body (400 without it)

# --- Read-only root -----------------------------------------------------------
ENABLE_OVERLAY="yes"
